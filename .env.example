# Copy this file to .env and adjust if needed:
#   Copy-Item .env.example .env
# For the live site, set these in Vercel instead (see DEPLOY.md).

# Postgres. Locally: the one from docker-compose.yml.
# On Neon: the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://tripstack:tripstack@localhost:5432/tripstack?schema=public"
# On Neon only: the direct connection string (same, without "-pooler"), used
# for database migrations. Leave unset locally.
# DIRECT_URL=""

# Auth (Better Auth)
# Generate a secret in PowerShell with:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
# The site's address, no trailing slash. Live: "https://your-domain"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google login. Leave empty to hide the "Continue with Google" button.
# See README → "Google login" for how to create these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (password resets, reminders) through Resend: https://resend.com
# Leave empty locally: emails are printed in the terminal instead.
RESEND_API_KEY=""
# Who emails come from; the domain must be verified in Resend.
# EMAIL_FROM="Tripster <hello@your-domain>"

# Daily reminder emails: Vercel Cron calls /api/cron/reminders with this as a
# bearer token. Any long random string (same command as BETTER_AUTH_SECRET).
# Leave empty locally: then anyone can trigger a run at
# http://localhost:3000/api/cron/reminders (emails print in the terminal).
CRON_SECRET=""

# Map tiles from MapTiler: https://cloud.maptiler.com/account/keys
# Public by design (the browser loads tiles with it): restrict it to your
# domain in MapTiler. Leave empty locally to use OpenStreetMap's own tiles.
NEXT_PUBLIC_MAPTILER_KEY=""

# Place search (OpenStreetMap Nominatim) asks every site to identify itself:
# the site name and a contact URL or email.
# NOMINATIM_USER_AGENT="Tripster (https://your-domain)"

# Optional: lets "Import from email" ask Claude to read booking emails that have
# no built-in booking data (only when the person presses "Read it with Claude";
# the email's text is sent to Anthropic). Get a key at https://console.anthropic.com.
# Leave empty to turn this off.
ANTHROPIC_API_KEY=
